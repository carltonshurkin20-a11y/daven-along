        { "translation": "Who clothes the naked.", "words": [{"text":"מַלְבִּישׁ","start":42.0,"end":42.7},{"text":"עֲרֻמִּים","start":42.8,"end":43.5}] }
      ]
    },
    {
      "id": "beracha-7",
      "title": "מַתִּיר אֲסוּרִים",
      "titleEn": "Beracha 7",
      "translation": "Blessed are You, Adonoy our God, King of the Universe, Who releases the imprisoned.",
