        { "translation": "Who straightens the bent.", "words": [{"text":"זוֹקֵף","start":55.0,"end":55.6},{"text":"כְּפוּפִים","start":55.7,"end":56.4}] }
      ]
    },
    {
      "id": "beracha-9",
      "title": "רוֹקַע הָאָֽרֶץ",
      "titleEn": "Beracha 9",
      "translation": "Blessed are You, Adonoy our God, King of the Universe, Who spreads the earth above the waters.",
      "lines": [
        { "translation": "Blessed are You, Adonoy our God, King of the Universe,", "words": [{"text":"בָּרוּךְ","start":57.5,"end":58.1},{"text":"אַתָּה","start":58.2,"end":58.7},{"text":"יְהֹוָה","start":58.8,"end":59.4},{"text":"אֱלֹהֵֽינוּ","start":59.5,"end":60.2},{"text":"מֶֽלֶךְ","start":60.3,"end":60.7},{"text":"הָעוֹלָם","start":60.8,"end":61.4}] },
        { "translation": "Who spreads the earth above the waters.", "words": [{"text":"רוֹקַע","start":61.5,"end":62.1},{"text":"הָאָֽרֶץ","start":62.2,"end":62.8},{"text":"עַל","start":62.9,"end":63.2},{"text":"הַמָּֽיִם","start":63.3,"end":63.9}] }
      ]
    },
    {
      "id": "beracha-10",
      "title": "שֶׁעָשָׂה לִי כָּל־צָרְכִּי",
      "titleEn": "Beracha 10",
      "translation": "Blessed are You, Adonoy our God, King of the Universe, Who provided me with all my needs.",
      "lines": [
        { "translation": "Blessed are You, Adonoy our God, King of the Universe,", "words": [{"text":"בָּרוּךְ","start":65.0,"end":65.6},{"text":"אַתָּה","start":65.7,"end":66.2},{"text":"יְהֹוָה","start":66.3,"end":66.9},{"text":"אֱלֹהֵֽינוּ","start":67.0,"end":67.7},{"text":"מֶֽלֶךְ","start":67.8,"end":68.2},{"text":"הָעוֹלָם","start":68.3,"end":68.9}] },
        { "translation": "Who provided me with all my needs.", "words": [{"text":"שֶׁעָשָׂה","start":69.0,"end":69.7},{"text":"לִי","start":69.8,"end":70.1},{"text":"כָּל־צָרְכִּי","start":70.2,"end":71.0}] }
      ]
    },
    {
      "id": "beracha-11",
      "title": "הַמֵּכִין מִצְעֲדֵי גָֽבֶר",
      "titleEn": "Beracha 11",
      "translation": "Blessed are You, Adonoy our God, King of the Universe, Who prepares the steps of man.",
      "lines": [
        { "translation": "Blessed are You, Adonoy our God, King of the Universe,", "words": [{"text":"בָּרוּךְ","start":72.0,"end":72.6},{"text":"אַתָּה","start":72.7,"end":73.2},{"text":"יְהֹוָה","start":73.3,"end":73.9},{"text":"אֱלֹהֵֽינוּ","start":74.0,"end":74.7},{"text":"מֶֽלֶךְ","start":74.8,"end":75.2},{"text":"הָעוֹלָם","start":75.3,"end":75.9}] },
        { "translation": "Who prepares the steps of man.", "words": [{"text":"הַמֵּכִין","start":76.0,"end":76.7},{"text":"מִצְעֲדֵי","start":76.8,"end":77.4},{"text":"גָֽבֶר","start":77.5,"end":78.1}] }
      ]
    },
    {
      "id": "beracha-12",
      "title": "אוֹזֵר יִשְׂרָאֵל בִּגְבוּרָה",
      "titleEn": "Beracha 12",
      "translation": "Blessed are You, Adonoy our God, King of the Universe, Who girds Israel with might.",
      "lines": [
        { "translation": "Blessed are You, Adonoy our God, King of the Universe,", "words": [{"text":"בָּרוּךְ","start":79.5,"end":80.1},{"text":"אַתָּה","start":80.2,"end":80.7},{"text":"יְהֹוָה","start":80.8,"end":81.4},{"text":"אֱלֹהֵֽינוּ","start":81.5,"end":82.2},{"text":"מֶֽלֶךְ","start":82.3,"end":82.7},{"text":"הָעוֹלָם","start":82.8,"end":83.4}] },
        { "translation": "Who girds Israel with might.", "words": [{"text":"אוֹזֵר","start":83.5,"end":84.1},{"text":"יִשְׂרָאֵל","start":84.2,"end":84.9},{"text":"בִּגְבוּרָה","start":85.0,"end":85.8}] }
      ]
    },
    {
      "id": "beracha-13",
      "title": "עוֹטֵר יִשְׂרָאֵל בְּתִפְאָרָה",
      "titleEn": "Beracha 13",
      "translation": "Blessed are You, Adonoy our God, King of the Universe, Who crowns Israel with glory.",
      "lines": [
        { "translation": "Blessed are You, Adonoy our God, King of the Universe,", "words": [{"text":"בָּרוּךְ","start":87.0,"end":87.6},{"text":"אַתָּה","start":87.7,"end":88.2},{"text":"יְהֹוָה","start":88.3,"end":88.9},{"text":"אֱלֹהֵֽינוּ","start":89.0,"end":89.7},{"text":"מֶֽלֶךְ","start":89.8,"end":90.2},{"text":"הָעוֹלָם","start":90.3,"end":90.9}] },
        { "translation": "Who crowns Israel with glory.", "words": [{"text":"עוֹטֵר","start":91.0,"end":91.6},{"text":"יִשְׂרָאֵל","start":91.7,"end":92.4},{"text":"בְּתִפְאָרָה","start":92.5,"end":93.3}] }
      ]
    },
    {
      "id": "beracha-14",
      "title": "הַנּוֹתֵן לַיָּעֵף כֹּֽחַ",
      "titleEn": "Beracha 14",
      "translation": "Blessed are You, Adonoy our God, King of the Universe, Who gives strength to the weary.",
      "lines": [
        { "translation": "Blessed are You, Adonoy our God, King of the Universe,", "words": [{"text":"בָּרוּךְ","start":94.5,"end":95.1},{"text":"אַתָּה","start":95.2,"end":95.7},{"text":"יְהֹוָה","start":95.8,"end":96.4},{"text":"אֱלֹהֵֽינוּ","start":96.5,"end":97.2},{"text":"מֶֽלֶךְ","start":97.3,"end":97.7},{"text":"הָעוֹלָם","start":97.8,"end":98.4}] },
        { "translation": "Who gives strength to the weary.", "words": [{"text":"הַנּוֹתֵן","start":98.5,"end":99.2},{"text":"לַיָּעֵף","start":99.3,"end":99.9},{"text":"כֹּֽחַ","start":100.0,"end":100.6}] }
      ]
    },
    {
      "id": "beracha-15",
      "title": "הַמַּעֲבִיר שֵׁנָה",
      "titleEn": "Beracha 15",
      "translation": "Blessed are You, Adonoy our God, King of the Universe, Who removes sleep from my eyes and slumber from my eyelids.",
      "lines": [
        { "translation": "Blessed are You, Adonoy our God, King of the Universe,", "words": [{"text":"בָּרוּךְ","start":102.0,"end":102.6},{"text":"אַתָּה","start":102.7,"end":103.2},{"text":"יְהֹוָה","start":103.3,"end":103.9},{"text":"אֱלֹהֵֽינוּ","start":104.0,"end":104.7},{"text":"מֶֽלֶךְ","start":104.8,"end":105.2},{"text":"הָעוֹלָם","start":105.3,"end":105.9}] },
        { "translation": "Who removes sleep from my eyes and slumber from my eyelids.", "words": [{"text":"הַמַּעֲבִיר","start":106.0,"end":106.8},{"text":"שֵׁנָה","start":106.9,"end":107.4},{"text":"מֵעֵינָי","start":107.5,"end":108.1},{"text":"וּתְנוּמָה","start":108.2,"end":108.9},{"text":"מֵעַפְעַפָּי","start":109.0,"end":109.8}] }
      ]
    },
    {
      "id": "yehi-ratzon",
      "title": "יְהִי רָצוֹן",
      "titleEn": "Yehi Ratzon",
      "translation": "And may it be Your will Adonoy, our God and God of our fathers, to make us study Torah regularly, and hold fast to Your commandments. Do not bring us into sin, transgression, or disgrace. Keep us far from an evil person and evil companion. Make us hold fast to good deeds. Grant us favor, kindness, and compassion in Your eyes and in the eyes of all who see us. Blessed are You, Adonoy, Who bestows bountiful kindness upon His people Israel.",
      "lines": [
        { "translation": "And may it be Your will, Adonoy our God and God of our fathers,", "words": [{"text":"וִיהִי","start":111.0,"end":111.6},{"text":"רָצוֹן","start":111.7,"end":112.3},{"text":"מִלְּ֒פָנֶֽיךָ","start":112.4,"end":113.1},{"text":"יְהֹוָה","start":113.2,"end":113.8},{"text":"אֱלֹהֵֽינוּ","start":113.9,"end":114.6},{"text":"וֵאלֹהֵי","start":114.7,"end":115.3},{"text":"אֲבוֹתֵֽינוּ","start":115.4,"end":116.1}] },
        { "translation": "To make us study Torah and hold fast to Your commandments,", "words": [{"text":"שֶׁתַּרְגִּילֵֽנוּ","start":116.2,"end":117.0},{"text":"בְּתוֹרָתֶֽךָ","start":117.1,"end":117.9},{"text":"וְדַבְּ֒קֵֽנוּ","start":118.0,"end":118.7},{"text":"בְּמִצְוֹתֶֽיךָ","start":118.8,"end":119.6}] },
        { "translation": "Do not bring us to sin, transgression, or disgrace,", "words": [{"text":"וְאַל","start":119.7,"end":120.1},{"text":"תְּבִיאֵֽנוּ","start":120.2,"end":120.9},{"text":"לֹא","start":121.0,"end":121.3},{"text":"לִידֵי","start":121.4,"end":121.8},{"text":"חֵטְא","start":121.9,"end":122.3},{"text":"וְלֹא","start":122.4,"end":122.8},{"text":"לִידֵי","start":122.9,"end":123.3},{"text":"עֲבֵרָה","start":123.4,"end":123.9},{"text":"וְעָוֹן","start":124.0,"end":124.5}] },
        { "translation": "Do not cause us to be tested or brought to disgrace,", "words": [{"text":"וְלֹא","start":124.6,"end":125.0},{"text":"לִידֵי","start":125.1,"end":125.5},{"text":"נִסָּיוֹן","start":125.6,"end":126.2},{"text":"וְלֹא","start":126.3,"end":126.7},{"text":"לִידֵי","start":126.8,"end":127.2},{"text":"בִזָּיוֹן","start":127.3,"end":127.9}] },
        { "translation": "Let us not be ruled by the Evil Inclination,", "words": [{"text":"וְאַל","start":128.0,"end":128.4},{"text":"יִשְׁלֹט","start":128.5,"end":129.0},{"text":"בָּֽנוּ","start":129.1,"end":129.5},{"text":"יֵֽצֶר","start":129.6,"end":130.0},{"text":"הָרָע","start":130.1,"end":130.6}] },
        { "translation": "Keep us far from evil people and evil companions,", "words": [{"text":"וְהַרְחִיקֵֽנוּ","start":130.7,"end":131.5},{"text":"מֵאָדָם","start":131.6,"end":132.1},{"text":"רָע","start":132.2,"end":132.5},{"text":"וּמֵחָבֵר","start":132.6,"end":133.1},{"text":"רָע","start":133.2,"end":133.5}] },
        { "translation": "Make us hold fast to the Good Inclination and to good deeds,", "words": [{"text":"וְדַבְּ֒קֵֽנוּ","start":133.6,"end":134.3},{"text":"בְּיֵֽצֶר","start":134.4,"end":134.9},{"text":"הַטּוֹב","start":135.0,"end":135.5},{"text":"וּבְמַעֲשִׂים","start":135.6,"end":136.3},{"text":"טוֹבִים","start":136.4,"end":136.9}] },
        { "translation": "Grant us favor, kindness and compassion in Your eyes,", "words": [{"text":"וּתְנֵֽנוּ","start":137.0,"end":137.6},{"text":"הַיּוֹם","start":137.7,"end":138.1},{"text":"לְחֵן","start":138.2,"end":138.6},{"text":"וּלְחֶֽסֶד","start":138.7,"end":139.2},{"text":"וּלְרַחֲמִים","start":139.3,"end":140.0},{"text":"בְּעֵינֶֽיךָ","start":140.1,"end":140.7}] },
        { "translation": "And in the eyes of all who see us,", "words": [{"text":"וּבְעֵינֵי","start":140.8,"end":141.4},{"text":"כָל־רוֹאֵֽינוּ","start":141.5,"end":142.3},{"text":"וְתִגְמְ֒לֵֽנוּ","start":142.4,"end":143.1},{"text":"חֲסָדִים","start":143.2,"end":143.8},{"text":"טוֹבִים","start":143.9,"end":144.4}] },
        { "translation": "Blessed are You, Adonoy, Who bestows bountiful kindness upon His people Israel.", "words": [{"text":"בָּרוּךְ","start":144.5,"end":145.1},{"text":"אַתָּה","start":145.2,"end":145.7},{"text":"יְהֹוָה","start":145.8,"end":146.4},{"text":"גּוֹמֵל","start":146.5,"end":147.0},{"text":"חֲסָדִים","start":147.1,"end":147.7},{"text":"טוֹבִים","start":147.8,"end":148.3},{"text":"לְעַמּוֹ","start":148.4,"end":148.9},{"text":"יִשְׂרָאֵל","start":149.0,"end":149.8}] }
      ]
    }
  ]
}