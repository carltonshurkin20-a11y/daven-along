        { "translation": "Who did not make me a woman.", "words": [{"text":"שֶׁלֹּא","start":28.5,"end":29.0},{"text":"עָשַֽׂנִי","start":29.1,"end":29.8},{"text":"אִשָּׁה","start":29.9,"end":30.5}] }
      ]
    },
    {
