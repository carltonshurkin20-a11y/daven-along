        { "translation": "Who did not make me a slave.", "words": [{"text":"שֶׁלֹּא","start":21.5,"end":22.0},{"text":"עָשַֽׂנִי","start":22.1,"end":22.8},{"text":"עָֽבֶד","start":22.9,"end":23.5}] }
      ]
    },
    {
      "id": "beracha-4",
      "title": "שֶׁלֹּא עָשַֽׂנִי אִשָּׁה",
      "titleEn": "Beracha 4",
      "translation": "Blessed are You, Adonoy our God, King of the Universe, Who did not make me a woman.",
