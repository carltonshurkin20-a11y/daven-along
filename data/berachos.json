  "sections": [
    {
      "id": "beracha-1",
      "title": "בִּרְכַּת הַשֶּׂכְוִי",
      "titleEn": "Beracha 1",
      "translation": "Blessed are You, Adonoy our God, King of the Universe, Who gives the rooster understanding to distinguish between day and night.",
      "lines": [
        { "translation": "Blessed are You, Adonoy our God, King of the Universe,", "words": [{"text":"בָּרוּךְ","start":0.5,"end":1.1},{"text":"אַתָּה","start":1.2,"end":1.7},{"text":"יְהֹוָה","start":1.8,"end":2.4},{"text":"אֱלֹהֵֽינוּ","start":2.5,"end":3.2},{"text":"מֶֽלֶךְ","start":3.3,"end":3.7},{"text":"הָעוֹלָם","start":3.8,"end":4.4}] },
        { "translation": "Who gives the rooster understanding to distinguish between day and night.", "words": [{"text":"אֲשֶׁר","start":4.5,"end":4.9},{"text":"נָתַן","start":5.0,"end":5.5},{"text":"לַשֶּֽׂכְוִי","start":5.6,"end":6.2},{"text":"בִינָה","start":6.3,"end":6.8},{"text":"לְהַבְחִין","start":6.9,"end":7.6},{"text":"בֵּין","start":7.7,"end":8.0},{"text":"יוֹם","start":8.1,"end":8.5},{"text":"וּבֵין","start":8.6,"end":9.0},{"text":"לָֽיְלָה","start":9.1,"end":9.8}] }
      ]
    },
    {
      "id": "beracha-2",
      "title": "שֶׁלֹּא עָשַֽׂנִי גּוֹי",
      "titleEn": "Beracha 2",
      "translation": "Blessed are You, Adonoy our God, King of the Universe, Who did not make me a gentile.",
      "lines": [
        { "translation": "Blessed are You, Adonoy our God, King of the Universe,", "words": [{"text":"בָּרוּךְ","start":10.5,"end":11.1},{"text":"אַתָּה","start":11.2,"end":11.7},{"text":"יְהֹוָה","start":11.8,"end":12.4},{"text":"אֱלֹהֵֽינוּ","start":12.5,"end":13.2},{"text":"מֶֽלֶךְ","start":13.3,"end":13.7},{"text":"הָעוֹלָם","start":13.8,"end":14.4}] },
        { "translation": "Who did not make me a gentile.", "words": [{"text":"שֶׁלֹּא","start":14.5,"end":15.0},{"text":"עָשַֽׂנִי","start":15.1,"end":15.8},{"text":"גּוֹי","start":15.9,"end":16.5}] }
      ]
    },
    {
      "id": "beracha-3",
      "title": "שֶׁלֹּא עָשַֽׂנִי עָֽבֶד",
      "titleEn": "Beracha 3",
      "translation": "Blessed are You, Adonoy our God, King of the Universe, Who did not make me a slave.",
      "lines": [
