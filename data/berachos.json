      ]
    },
    {
      "id": "beracha-8",
      "title": "זוֹקֵף כְּפוּפִים",
      "titleEn": "Beracha 8",
      "translation": "Blessed are You, Adonoy our God, King of the Universe, Who straightens the bent.",
