 {
  "id": 2,
  "slug": "adon-olam",
  "nameHeb": "אֲדוֹן עוֹלָם",
  "nameEn": "Adon Olam",
  "nusach": "ashkenaz",
  "timeOfDay": "morning",
  "totalDuration": 48,
  "audioUrl": "/audio/02 Adon Olam.mp3",
  "sections": [
    {
      "id": "adon-olam-main",
      "title": "אֲדוֹן עוֹלָם",
      "titleEn": "Adon Olam",
      "translation": "Master of the universe",
      "lines": [
        { "translation": "Master of the universe, who reigned before any form was created", "words": [{"text":"אֲדוֹן","start":0.431,"end":1.092},{"text":"עוֹלָם","start":1.112,"end":1.512},{"text":"אֲשֶׁר","start":1.712,"end":2.153},{"text":"מָלַךְ","start":2.233,"end":2.753}] },
        { "translation": "Before any form was created", "words": [{"text":"בְּטֶֽרֶם","start":2.833,"end":3.453},{"text":"כָּל","start":3.513,"end":3.734},{"text":"יְצִיר","start":3.834,"end":4.234},{"text":"נִבְרָא","start":4.334,"end":4.934}] },
        { "translation": "At the time when His will brought all into being", "words": [{"text":"לְעֵת","start":5.395,"end":5.875},{"text":"נַעֲשָׂה","start":5.915,"end":6.456},{"text":"בְחֶפְצוֹ","start":6.536,"end":7.096},{"text":"כֹּל","start":7.116,"end":7.536}] },
        { "translation": "Then as King His name was proclaimed", "words": [{"text":"אֲזַי","start":7.917,"end":8.417},{"text":"מֶֽלֶךְ","start":8.437,"end":8.817},{"text":"שְׁמוֹ","start":8.877,"end":9.117},{"text":"נִקְרָא","start":9.238,"end":9.758}] },
        { "translation": "After all has ceased to be", "words": [{"text":"וְאַחֲרֵי","start":10.298,"end":10.959},{"text":"כִּכְ֒לוֹת","start":11.259,"end":11.739},{"text":"הַכֹּל","start":11.839,"end":12.52}] },
        { "translation": "He alone will reign in awe", "words": [{"text":"לְבַדּוֹ","start":12.92,"end":13.801},{"text":"יִמְלֹךְ","start":13.881,"end":14.141},{"text":"נוֹרָא","start":14.201,"end":14.721}] },
        { "translation": "He was, He is", "words": [{"text":"וְהוּא","start":15.142,"end":15.482},{"text":"הָיָה","start":15.582,"end":15.802},{"text":"וְהוּא","start":15.862,"end":16.263},{"text":"הֹוֶה","start":16.283,"end":16.563}] },
        { "translation": "And He shall be in glory", "words": [{"text":"וְהוּא","start":16.723,"end":16.843},{"text":"יִהְיֶה","start":16.903,"end":17.323},{"text":"בְּתִפְאָרָה","start":17.423,"end":17.864}] },
        { "translation": "He is One, and there is no other", "words": [{"text":"וְהוּא","start":17.944,"end":18.764},{"text":"אֶחָד","start":19.205,"end":19.425},{"text":"וְאֵין","start":19.525,"end":19.865},{"text":"שֵׁנִי","start":19.905,"end":20.305}] },
        { "translation": "To compare to Him or to be His equal", "words": [{"text":"לְהַמְשִׁיל","start":20.385,"end":20.846},{"text":"לוֹ","start":21.206,"end":21.967},{"text":"לְהַחְבִּֽירָה","start":22.007,"end":22.387}] },
        { "translation": "Without beginning, without end", "words": [{"text":"בְּלִי","start":22.467,"end":23.468},{"text":"רֵאשִׁית","start":23.948,"end":24.168},{"text":"בְּלִי","start":24.228,"end":24.749},{"text":"תַכְלִית","start":24.789,"end":24.989}] },
        { "translation": "His is the power and the dominion", "words": [{"text":"וְלוֹ","start":25.049,"end":25.809},{"text":"הָעֹז","start":26.13,"end":26.41},{"text":"וְהַמִּשְׂרָה","start":26.47,"end":27.05}] },
        { "translation": "He is my God, my living Redeemer", "words": [{"text":"וְהוּא","start":28.371,"end":28.572},{"text":"אֵלִי","start":28.652,"end":29.012},{"text":"וְחַי","start":29.073,"end":29.674},{"text":"גּוֹאֲלִי","start":29.734,"end":30.254}] },
        { "translation": "My Rock in times of trouble and distress", "words": [{"text":"וְצוּר","start":30.715,"end":31.136},{"text":"חֶבְלִי","start":31.276,"end":31.737},{"text":"בְּעֵת","start":31.797,"end":32.238},{"text":"צָרָה","start":32.318,"end":32.498}] },
        { "translation": "He is my banner and my refuge", "words": [{"text":"וְהוּא","start":32.638,"end":33.58},{"text":"נִסִּי","start":33.64,"end":34.061},{"text":"וּמָנוֹס","start":34.141,"end":34.762},{"text":"לִי","start":34.882,"end":35.403}] },
        { "translation": "My portion in the cup on the day I call", "words": [{"text":"מְנָת","start":35.784,"end":36.124},{"text":"כּוֹסִי","start":36.184,"end":36.685},{"text":"בְּיוֹם","start":36.745,"end":37.086},{"text":"אֶקְרָא","start":37.166,"end":37.947}] },
        { "translation": "Into His hand I entrust my spirit", "words": [{"text":"בְּיָדוֹ","start":38.448,"end":38.969},{"text":"אַפְקִיד","start":39.029,"end":39.209},{"text":"רוּחִי","start":39.249,"end":39.409}] },
        { "translation": "When I sleep and when I wake", "words": [{"text":"בְּעֵת","start":39.53,"end":40.271},{"text":"אִישַׁן","start":40.391,"end":40.832},{"text":"וְאָעִֽירָה","start":40.852,"end":41.393}] },
        { "translation": "And with my spirit, my body too", "words": [{"text":"וְעִם","start":41.473,"end":41.693},{"text":"רוּחִי","start":41.773,"end":42.595},{"text":"גְּוִיָּתִי","start":43.075,"end":43.396}] },
        { "translation": "Hashem is with me, I shall not fear", "words": [{"text":"יְהֹוָה","start":43.436,"end":43.837},{"text":"לִי","start":43.897,"end":44.177},{"text":"וְלֹא","start":44.197,"end":45.339},{"text":"אִירָא","start":45.78,"end":46.221}] }
      ]
    }
  ]
}